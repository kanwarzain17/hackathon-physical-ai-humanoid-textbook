{
  "version": 2,
  "builds": [
    {
      "src": "backend/api.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend_book/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api(/.*)?",
      "dest": "backend/api.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend_book/build/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend_book/build/index.html"
    }
  ]
}
